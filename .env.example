# Supabase Service Role (backend only — nunca expor no frontend)
SUPABASE_URL=https://syxxuumxkhhnoqrxporj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<sua-service-role-key>

# WhatsApp / Meta Cloud API
WA_VERIFY_TOKEN=<token-seguro-para-verificacao-do-webhook>
WA_ACCESS_TOKEN=<token-de-acesso-permanente-da-meta>
WA_APP_SECRET=<app-secret-do-meta-app-usado-para-validar-hmac>
# App ID do Meta App da Áion — usado só pelo Cadastro Incorporado (Embedded
# Signup), na troca do `code` do popup por access_token (api/whatsapp/embedded-signup.ts)
WA_APP_ID=<app-id-do-meta-app>

# Cadastro Incorporado (Embedded Signup) — botão "Conectar via Meta" no painel
# do gestor (src/components/whatsapp/EmbeddedSignupButton.tsx). VITE_WA_APP_ID
# é o mesmo App ID acima, exposto ao frontend (não é segredo — necessário pro
# FB.init() do SDK da Meta). VITE_WA_CONFIG_ID é o ID da configuração
# "Áion Edu — Onboarding Escolas" já criada no Meta App.
VITE_WA_APP_ID=<mesmo-app-id-do-meta-app>
VITE_WA_CONFIG_ID=4171646536460369

# Domínio estável da aplicação (sem barra final) — usado para montar o
# redirect_uri do OAuth do Google e o webhook do Evolution API
APP_URL=https://aionedu.com.br

# Google OAuth (Calendar/Meet com conta Gmail pessoal, não Workspace).
# Criar em Google Cloud Console → APIs & Services → Credentials → OAuth
# client ID (tipo "Web application"), com redirect URI:
#   https://<seu-dominio>/api/google/oauth-callback
# Precisa ser configurado EM DOIS LUGARES com os mesmos valores:
#   1. Vercel (Project Settings → Environment Variables) — usado por api/google/*.ts
#   2. Supabase (Edge Functions → create-google-meet → Manage secrets) — usado
#      pela function para trocar o refresh_token salvo por um access_token novo
GOOGLE_OAUTH_CLIENT_ID=<client-id-do-google-cloud-console>
GOOGLE_OAUTH_CLIENT_SECRET=<client-secret-do-google-cloud-console>